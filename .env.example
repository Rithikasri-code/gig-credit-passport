# Copy this to .env and fill in real values. Never commit the real .env file.

ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gigpassport

SECRET_KEY=replace-with-a-long-random-string
# Separate on purpose from SECRET_KEY — see the comment in app/core/config.py
PASSPORT_SIGNING_KEY=replace-with-a-different-long-random-string

# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ALLOWED_ORIGINS=https://app.yourcompany.com,https://yourcompany.com
# Leave empty in local dev (falls back to wide-open when DEBUG=true).
# MUST be set in production — the app refuses to start otherwise.
CORS_ALLOWED_ORIGINS=

AA_PROVIDER=setu
AA_BASE_URL=https://fiu-sandbox.setu.co
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_PRODUCT_INSTANCE_ID=

MODEL_PATH=app/scoring/artifacts/model.pkl
MODEL_VERSION=v0.2.0
